{
  "name": "roam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "node tools/database/setup-local.mjs",
    "db:migrate": "node --import tsx tools/database/migrate.ts",
    "db:import": "node --import tsx tools/database/import-catalog.ts",
    "db:verify": "node --import tsx tools/database/verify.ts",
    "db:backup": "node tools/database/backup-local.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "maplibre-gl": "6.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
